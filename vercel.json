{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/Nerella Lakshmi Thanmai.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Nerella_Lakshmi_Thanmai_Resume.pdf\""
        }
      ]
    }
  ]
}
